{
  "strategy": {
    "method": "hybrid_ai",
    "max_generations": 20,
    "population_size": 20,
    "crossover_prob": 0.8,
    "mutation_prob": 0.1,
    "tournament_size": 3,
    "elite_count": 2,
    "epsilon": 1e-6,
    "max_stagnant_epochs": 8
  },
  "parameters": {
    "mins": [0.004, 0.018, 0.005],
    "maxs": [0.012, 0.026, 0.025],
    "names": ["c1", "c2", "c3"]
