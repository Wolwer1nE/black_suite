<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Просмотр результатов оптимизации</title>
  <link rel="stylesheet" href="/lib/bootstrap.css">
  <link rel="stylesheet" href="/styles.css">
  <script src="/lib/plotly.js"></script>
</head>
<body>
<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
    <div>
      <h2 class="mb-1">Просмотр результатов оптимизации</h2>
      <p class="text-muted mb-0">Выберите кэш слева или откройте просмотрщик сеток и нормалей.</p>
    </div>
    <a href="/shapes" class="btn btn-outline-primary">Открыть просмотрщик сеток</a>
  </div>
  <div class="row">
    <!-- Левая панель со списком кэшей -->
    <div class="col-md-3">
      <h4>Результаты оптимизации</h4>
      <div id="cache-list" class="list-group">
        <div class="text-center p-3">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
          </div>
          <p class="mt-2">Загрузка кэшей...</p>
        </div>
      </div>
    </div>
    
    <!-- Правая панель с деталями и графиками -->
    <div class="col-md-9">
      <div id="cache-details">
        <div class="text-center text-muted p-5">
          <h5>Выберите кэш для просмотра</h5>
          <p>Кликните на любой кэш в списке слева, чтобы увидеть детальную информацию и графики</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Модальное окно для детального просмотра точек -->
<div class="modal fade" id="pointsModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Детальная информация о точках</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="points-table"></div>
      </div>
    </div>
  </div>
</div>

<script src="/main.js"></script>
</body>
</html>
